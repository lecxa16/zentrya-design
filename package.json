{
  "name": "@zentrya/design",
  "version": "2.5.4",
  "description": "Sistema de diseño de Zentrya para proyectos React: tokens claro/oscuro, primitivas, armazón de navegación y formularios.",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "LEEME.md",
    "GUIA.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./mui": "./dist/mui.js",
    "./estilos.css": "./dist/estilos.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --config vite.catalogo.config.js",
    "build:catalogo": "vite build --config vite.catalogo.config.js",
    "contraste": "node scripts/contraste.mjs"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.0",
    "dayjs": "^1.11.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
