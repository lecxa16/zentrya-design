{
  "name": "@zentrya/design",
  "version": "1.4.4",
  "description": "Sistema de diseño de Zentrya para proyectos React: tokens claro/oscuro, primitivas, armazón de navegación y formularios.",
  "private": true,
  "type": "module",
  "files": ["dist", "LEEME.md", "GUIA.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
